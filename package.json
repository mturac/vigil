{
  "name": "vigil",
  "version": "0.1.0",
  "description": "Self-hosted AI engineer for your whole SDLC: autonomous code review, incident investigation, verified fixes, team memory, connectors and automations. Bring your own model.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vigil": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:boot": "tsx scripts/devdb.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@octokit/rest": "^21.0.2",
    "@prisma/client": "^6.2.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.79.1",
    "pino": "^9.6.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
