# ---- Database (PostgreSQL only — no sqlite anywhere) ----
DATABASE_URL=postgresql://vigil:vigil@localhost:5432/vigil

# ---- LLM (bring your own model; product works without one in heuristics mode) ----
# provider: openai | anthropic | mock   (openai provider works with ANY OpenAI-compatible
# endpoint: OpenAI, Ollama, vLLM, OpenRouter, DeepSeek, Groq, LM Studio, Z.ai, ...)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Extra HTTP headers for gateways that need side-car auth (JSON object), e.g.
# Z.ai gateway deployments that require a session token next to the API key:
# LLM_HEADERS={"X-Token":"<jwt>","X-Z-AI-From":"Z"}
LLM_HEADERS=
ANTHROPIC_API_KEY=
# cost attribution (USD per 1M tokens); falls back to built-in table
LLM_PRICE_IN_PER_M=
LLM_PRICE_OUT_PER_M=

# ---- GitHub (review engine, fix PRs, chat) ----
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE=            # optional, e.g. https://github.enterprise/api/v3

# ---- GitLab ----
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# ---- Slack (Agent-for-Slack style surface) ----
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ---- Optional connectors (context + actions; see docs/CONNECTORS.md) ----
LINEAR_API_KEY=
JIRA_HOST=
JIRA_EMAIL=
JIRA_TOKEN=
SENTRY_HOST=
SENTRY_TOKEN=
SENTRY_ORG=
DATADOG_HOST=
DATADOG_API_KEY=
DATADOG_APP_KEY=
PAGERDUTY_TOKEN=
NOTION_KEY=

# ---- MCP servers (JSON array; tools are exposed to the agent) ----
# MCP_SERVERS=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/repos"]}]

# ---- Server ----
PORT=8080
DASHBOARD_PASSWORD=          # optional; if set, dashboard/API require ?key= or Bearer
REPOS=                       # daemon poll list, e.g. mturac/vigil,demo/app
POLL_INTERVAL_SEC=60
LOG_LEVEL=info
